# ---- llm-hub ----------------------------------------------------------
# Each profile is an upstream OpenAI-compatible API, exposed as <profile>/<model>.
# Profiles are auto-discovered from LLM_HUB_<NAME>_BASE_URL vars.
# Optional: set LLM_HUB_PROFILES to control which load, their order, and
# canonical names with dashes (env segments cannot express "-"):
# LLM_HUB_PROFILES=openai,groq,local

# Per-profile settings: LLM_HUB_<NAME>_* (name uppercased, - becomes _)
LLM_HUB_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_HUB_OPENAI_API_KEY=sk-...
# LLM_HUB_OPENAI_DISPLAY_NAME=OpenAI

LLM_HUB_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_HUB_GROQ_API_KEY=gsk_...
# Optional extras:
# LLM_HUB_GROQ_DISPLAY_NAME=Groq          # UI label (routing id stays "groq")
# LLM_HUB_GROQ_HEADERS={"x-my-header":"value"}   # extra headers (JSON object)
# LLM_HUB_GROQ_TIMEOUT_MS=30000                  # per-attempt timeout
# LLM_HUB_GROQ_ENABLED=false                     # hide without deleting

LLM_HUB_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LLM_HUB_LOCAL_API_KEY=none
# Static model list for upstreams without /v1/models:
# LLM_HUB_LOCAL_MODELS=mistral-7b,qwen-32b

# ---- pricing (optional; used for /stats estimated cost) ---------------
# USD per 1M tokens. Unset/0 = free (local) unless a built-in cloud guess matches.
# LLM_HUB_OPENAI_INPUT_USD_PER_1M=2.50
# LLM_HUB_OPENAI_OUTPUT_USD_PER_1M=10
# LLM_HUB_OPENAI_CACHE_READ_USD_PER_1M=1.25
# LLM_HUB_OPENAI_MODEL_PRICES=gpt-4o-mini:0.15/0.60,gpt-4o:2.50/10
# Global fallback when a profile has no rates:
# LLM_HUB_INPUT_USD_PER_1M=0
# LLM_HUB_OUTPUT_USD_PER_1M=0

# ---- server -----------------------------------------------------------
# LLM_HUB_BIND=127.0.0.1          # local-only by default
# LLM_HUB_PORT=8410

# ---- auth (optional, off by default: local tool) ----------------------
# Set to require a key on /v1/* and /api/* (UI prompts once):
# LLM_HUB_MASTER_KEY=change-me

# ---- fallbacks --------------------------------------------------------
# Default fallback chain applied when the X-LLM-Hub-Fallbacks header is absent:
# LLM_HUB_DEFAULT_FALLBACKS=groq/llama-3.3-70b-versatile,openai/gpt-4o-mini
# Max request-body bytes buffered to allow retrying an attempt (default 2MB):
# LLM_HUB_MAX_REPLAY_BYTES=2097152

# ---- persistence (optional, off by default) ---------------------------
# Durable usage history + hub API keys:
# LLM_HUB_PERSISTENT=true
# LLM_HUB_STORE=sqlite            # sqlite (default) | json
# LLM_HUB_STORE_PATH=llm-hub.db
# Block UI writes to this .env (k8s/secret deploys):
# LLM_HUB_CONFIG_READONLY=true

# ---- auto-update ------------------------------------------------------
# Auto-update is enabled by default; set false to disable:
# LLM_HUB_AUTO_UPDATE=false
